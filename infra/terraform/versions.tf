terraform {
  required_version = ">= 1.7.0"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 8.0"
    }
    google-beta = {
      source  = "hashicorp/google-beta"
      version = "~> 8.0"
    }
    namedotcom = {
      source  = "lexfrei/namedotcom"
      version = "~> 4.1"
    }
  }
}

provider "google" {
  project               = var.project_id
  region                = var.region
  billing_project       = var.project_id
  user_project_override = true
}

provider "google-beta" {
  project               = var.project_id
  region                = var.region
  billing_project       = var.project_id
  user_project_override = true
}

# Credentials come from NAMEDOTCOM_USERNAME and NAMEDOTCOM_TOKEN in the
# environment (see README.md). Never put them in a .tf or .tfvars file.
provider "namedotcom" {}

